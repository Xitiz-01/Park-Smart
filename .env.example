# Settings for the local Docker Compose stack (docker-compose.yml).
#   cp .env.example .env && docker compose up --wait
# Everything here is for a stack bound to 127.0.0.1 on your machine. Never
# reuse these values anywhere else. backend/.env.example lists every backend
# variable for running the API outside Docker.

# Seed accounts (customer|admin|vendor|applicant@parksmart.test) sign in with
# this password. The seed refuses to run in production or against a remote DB.
SEED_PASSWORD=parksmart-local-only

# Local-only placeholders; development mode accepts them. Generate real ones
# (openssl rand -base64 48) for anything that leaves your machine.
BETTER_AUTH_SECRET=local-compose-only-not-a-real-secret-000000
ADDRESS_SELECTION_SECRET=local-compose-only-not-a-real-secret-111111

# Host ports (127.0.0.1). 5000 is avoided: macOS uses it for AirPlay.
WEB_PORT=8080
API_PORT=5001
MONGO_PORT=27018
REDIS_PORT=6380

# development (default; seeding allowed) or production.
NODE_ENV=development
LOG_LEVEL=info
MONGO_DB=parksmart

# Optional provider keys (the app works without them, with fewer features).
GEOCODING_API_KEY=
API_NINJAS_API_KEY=

# `--profile tools`: mongo-express on 8081 (basic auth below), Redis Insight on 5540.
TOOLS_USERNAME=parksmart
TOOLS_PASSWORD=parksmart-local-only
