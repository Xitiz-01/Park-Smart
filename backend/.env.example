PORT=5000
MONGODB_URI=mongodb://localhost:27017/parking-system
NODE_ENV=development
CLIENT_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SUPER_ADMIN_USER_IDS=
BETTER_AUTH_CROSS_SITE_COOKIES=false
BETTER_AUTH_MONGO_TRANSACTIONS=false
ADDRESS_SELECTION_SECRET=replace_with_a_separate_long_random_string
EXTERNAL_PARKING_CACHE_TTL_MS=120000
GEOCODING_PROVIDER=geoapify
GEOCODING_API_KEY=your_geoapify_api_key
# Optional paid primary catalog. This key is read by the backend only.
API_NINJAS_API_KEY=

# Private vendor verification documents. Local storage is for a single-instance
# development deployment; production should mount persistent private storage or
# add an object-storage adapter before scaling horizontally.
VERIFICATION_STORAGE_PROVIDER=local
VERIFICATION_STORAGE_LOCAL_PATH=

# DigiLocker Requester is optional and remains disabled until approved requester
# credentials and the deployment-specific endpoints are configured.
DIGILOCKER_ENABLED=false
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://api.parksmart.live/api/vendor-verification/digilocker/callback
DIGILOCKER_AUTHORIZATION_URL=
DIGILOCKER_TOKEN_URL=
DIGILOCKER_DOCUMENTS_URL=

# Cashfree Secure ID is optional. The adapter currently calls only its PAN and
# GSTIN verification APIs; all credentials remain backend-only.
CASHFREE_VERIFY_ENABLED=false
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_VERIFY_BASE_URL=https://sandbox.cashfree.com/verification
