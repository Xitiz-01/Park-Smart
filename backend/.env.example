# Every variable is validated at boot by src/config/env.js; a bad value stops
# the server with a list of what to fix. Only MONGODB_URI is always required.
# In production BETTER_AUTH_SECRET (32+ characters) and ADDRESS_SELECTION_SECRET
# are required too.
PORT=5000
MONGODB_URI=mongodb://localhost:27017/parking-system
# development | test | production
NODE_ENV=development
# Optional: fatal | error | warn | info | debug | trace | silent. Defaults to
# debug in development, silent under test and info in production.
LOG_LEVEL=
# Requests slower than this (milliseconds) are logged as warnings.
SLOW_REQUEST_MS=1500

# HTTP hardening. TRUST_PROXY is Express's "trust proxy": a hop count,
# true/false, or a range such as loopback. Defaults to 1 in production (one load
# balancer in front, e.g. Render) and loopback elsewhere. Rate limits are per IP
# per window, in memory until Redis arrives.
TRUST_PROXY=
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
CLIENT_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API with cookies.
# CLIENT_URL and BETTER_AUTH_TRUSTED_ORIGINS are added automatically.
CORS_ORIGINS=http://localhost:3000,https://park-smart-eight.vercel.app
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SUPER_ADMIN_USER_IDS=
BETTER_AUTH_CROSS_SITE_COOKIES=false
BETTER_AUTH_MONGO_TRANSACTIONS=false
ADDRESS_SELECTION_SECRET=replace_with_a_separate_long_random_string
EXTERNAL_PARKING_CACHE_TTL_MS=120000
GEOCODING_PROVIDER=geoapify
GEOCODING_API_KEY=your_geoapify_api_key
# Optional paid primary catalog. This key is read by the backend only.
API_NINJAS_API_KEY=

# Private vendor verification documents. Local storage is for a single-instance
# development deployment; production should mount persistent private storage or
# add an object-storage adapter before scaling horizontally.
VERIFICATION_STORAGE_PROVIDER=local
VERIFICATION_STORAGE_LOCAL_PATH=

# Cashfree Secure ID is optional. The adapter calls its PAN, GSTIN and Bank
# Account Verification (Sync V2) APIs; all credentials remain backend-only.
CASHFREE_VERIFY_ENABLED=false
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_VERIFY_BASE_URL=https://sandbox.cashfree.com/verification

# Feature flags for later phases (true/false). Leave them off until the phase
# that uses them says otherwise.
CLERK_ENABLED=false
PAYMENTS_ENABLED=false
PASSES_ENABLED=false
