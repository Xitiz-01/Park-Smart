{
  "name": "parking-system-backend",
  "version": "1.0.0",
  "description": "Real-Time Parking Slot Availability Analysis and Guidance System - Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:user-roles": "node scripts/migrateUserRoles.js",
    "migrate:better-auth": "node scripts/migrateBetterAuthUsers.js",
    "migrate:parking-slot-indexes": "node scripts/migrateParkingSlotIndexes.js",
    "migrate:hybrid-parking": "node scripts/migrateHybridParking.js",
    "migrate:vehicle-fuel-type": "node scripts/migrateVehicleFuelType.js",
    "migrate:vehicle-body-style": "node scripts/migrateVehicleBodyStyle.js",
    "migrate:remove-digilocker": "node scripts/removeDigiLockerData.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test node --test tests/*.unit.test.js",
    "test:integration": "NODE_ENV=test node --test --test-concurrency=1 tests/*.integration.test.js",
    "test:coverage": "NODE_ENV=test c8 node --test --test-concurrency=1 tests/*.unit.test.js tests/*.integration.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.6",
    "bcryptjs": "^2.4.3",
    "better-auth": "1.7.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "mongoose": "^8.4.1",
    "multer": "^2.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
